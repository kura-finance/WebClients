
# --- Kura backend (optional) ---
# Empty (default): community edition. No backend, no account and no Privy.
# The user creates or imports a wallet in the browser; its key is kept in a
# password-encrypted vault in localStorage and unlocked with that password.
# The app only talks to Base RPC / public APIs: Smart Wallet, Treasury (list
# kept in this browser's localStorage), Approvals, Team, Report, Earn, Borrow,
# Markets.
# Set it to a self-hosted backendserver to switch to Privy login (embedded
# wallet) and turn the backend features back on: TrackFi (Plaid / DeBank / CEX),
# bank transfers (Bridge), card waitlist, tokenized stocks (Dinari), Stripe
# billing + membership gate, passkey E2EE, profile edit / delete, and
# server-side Treasury sync. See app/config/features.ts.
NEXT_PUBLIC_BACKEND_URL=
# Self-hosted example: NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# --- Web app origin (CORS, CSP, WebAuthn, Privy allowed origins) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_APP_URL=https://app.kura-finance.com

# --- API origin for CSP connect-src (defaults to api.kura-finance.com; backend mode only) ---
# NEXT_PUBLIC_API_URL=https://api.kura-finance.com

# --- Privy (backend mode only: login + embedded wallet) — https://dashboard.privy.io ---
# Not used and not needed when NEXT_PUBLIC_BACKEND_URL is empty.
# NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# --- Reown / WalletConnect (backend mode only: TrackFi wallet tracking) — https://cloud.reown.com ---
# NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id

# --- logo.dev (optional — stock icons, and crypto icons for unlisted tokens) — https://www.logo.dev ---
# Without it, listed tokens use fixed images on CoinGecko's image CDN (app/lib/tokenLogos.ts).
# NEXT_PUBLIC_LOGODEV_TOKEN=pk_xxx

# --- Base RPC (recommended for Home / Portfolio / Safe owners) ---
# Public mainnet.base.org rate-limits aggressively (429). Prefer Alchemy.
# NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_key
# NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_alchemy_key

# --- Pimlico (optional — pay Smart Wallet gas in USDC) ---
# Used by: Transfer (Send crypto), Earn deposit/withdraw, Borrow, Markets swap
# when acting from the personal Smart Wallet (not Treasury propose).
# Key + PAY_GAS_IN_USDC=true (default) → gas is paid in USDC (ERC-20 paymaster).
# No key → UserOps use Pimlico's public bundler and the Safe pays gas in ETH,
# so the wallet needs a little ETH on Base (same as the mobile app).
# NEXT_PUBLIC_PIMLICO_API_KEY=pim_xxx
# NEXT_PUBLIC_PAY_GAS_IN_USDC=true

# --- Li.Fi (optional — rate limits, or your own integrator fee) ---
# Hosted production sets no integrator and no fee. To take a fee yourself,
# register an integrator at portal.li.fi and set both. The fee is a FRACTION of
# the amount swapped, taken from the user: 0.0025 = 0.25%, 0.25 = 25%.
# NEXT_PUBLIC_LIFI_INTEGRATOR=
# NEXT_PUBLIC_LIFI_FEE=
# NEXT_PUBLIC_LIFI_API_KEY=

# --- Stripe plan price IDs (optional — billing UI; backend mode only) — https://dashboard.stripe.com ---
# NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_xxx
# NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_xxx
# NEXT_PUBLIC_STRIPE_PRICE_ULTIMATE_MONTHLY=price_xxx
# NEXT_PUBLIC_STRIPE_PRICE_ULTIMATE_YEARLY=price_xxx

# --- Build mode (optional; Dockerfile sets BUILD_MODE=standalone) ---
# BUILD_MODE=export         # static export for CDN — npm run build:static
